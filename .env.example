# PostgreSQL local ou URL de connexion PostgreSQL de votre projet Supabase (Settings > Database)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# Générer avec des valeurs cryptographiques aléatoires (voir README.md). Ne jamais les commiter.
DATA_ENCRYPTION_KEY=BASE64_OF_32_RANDOM_BYTES
LOOKUP_KEY=BASE64_OF_32_RANDOM_BYTES
# Facultatif : anciennes clés connues si une autre génération est déjà utilisée.
# PREVIOUS_DATA_ENCRYPTION_KEY=
# PREVIOUS_LOOKUP_KEY=
# URL PUBLIQUE réelle du site. Ne laissez pas localhost sur un hébergement HTTPS.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Pour une publication permanente, définir avant le build :
# SUNU_ENV=production
# Origines HTTPS additionnelles autorisées pour intégrer l’aperçu géré (séparées par des espaces).
# SUNU_PREVIEW_ANCESTORS=
# Seulement derrière un proxy maîtrisé qui remplace X-Forwarded-Host :
# SUNU_TRUST_PROXY=1
# Aperçu local isolé : volume privé facultatif pour les clés de l'instance.
# SUNU_STATE_DIR=/volume-prive/sunu-ecole
# Courrier transactionnel indispensable pour le contact et le mot de passe oublié.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ecolesunu@gmail.com
